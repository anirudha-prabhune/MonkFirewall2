{
  "manifest_version": 3,
  "name": "MonkTrades Trading Firewall Extension",
  "version": "1.0.0",
  "description": "Enforces server-authoritative Trading Firewall lockouts on Kite Zerodha.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://kite.zerodha.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost/*",
    "https://monk-firewall.ai.studio/*",
    "https://ais-dev-wyyezpv6s2lo3nusdgb6dl-608043296632.asia-southeast1.run.app/*",
    "https://ais-pre-wyyezpv6s2lo3nusdgb6dl-608043296632.asia-southeast1.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost/*",
        "https://monk-firewall.ai.studio/*",
        "https://ais-dev-wyyezpv6s2lo3nusdgb6dl-608043296632.asia-southeast1.run.app/*",
        "https://ais-pre-wyyezpv6s2lo3nusdgb6dl-608043296632.asia-southeast1.run.app/*"
      ],
      "js": ["content_monktrades.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://kite.zerodha.com/*"
      ],
      "js": ["content_kite.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
