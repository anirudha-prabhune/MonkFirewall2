{
  "manifest_version": 3,
  "name": "MonkTrades Trading Firewall Extension",
  "version": "1.0.0",
  "description": "Enforces server-authoritative Trading Firewall lockouts on Kite Zerodha.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.zerodha.com/*",
    "http://localhost:3000/*",
    "https://ais-dev-*.run.app/*",
    "https://ais-pre-*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://ais-dev-*.run.app/*",
        "https://ais-pre-*.run.app/*"
      ],
      "js": ["content_monktrades.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://kite.zerodha.com/*"
      ],
      "js": ["content_kite.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
